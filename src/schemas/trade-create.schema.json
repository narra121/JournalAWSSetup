{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trade-create.schema.json",
  "type": "object",
  "required": [
    "symbol",
    "side",
    "quantity",
    "openDate",
    "entryPrice",
    "exitPrice",
    "closeDate",
    "outcome",
    "pnl"
  ],
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "quantity": {
      "type": "number",
      "minimum": 1e-07
    },
    "entryPrice": {
      "type": "number",
      "minimum": 0
    },
    "exitPrice": {
      "type": "number",
      "minimum": 0
    },
    "stopLoss": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "takeProfit": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "openDate": {
      "type": "string",
      "pattern": "^\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|[12]\\d))(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-](?:[01]\\d|2[0-3]):?[0-5]\\d)?)?$"
    },
    "closeDate": {
      "type": "string",
      "pattern": "^\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|[12]\\d))(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-](?:[01]\\d|2[0-3]):?[0-5]\\d)?)?$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "TP",
        "SL",
        "PARTIAL",
        "BREAKEVEN"
      ]
    },
    "pnl": {
      "type": "number"
    },
    "riskRewardRatio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "setupType": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "tradingSession": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "marketCondition": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "tradeNotes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "newsEvents": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "maxItems": 50
    },
    "mistakes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 50
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 50
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      },
      "maxItems": 10
    },
    "accountId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "accountIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 10
    },
    "brokenRuleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 50
    },
    "reviewed": {
      "type": "boolean"
    },
    "images": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "base64Data": {
            "type": "string"
          },
          "timeframe": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        }
      }
    },
    "assetClass": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "stock",
        "forex",
        "futures",
        "options",
        "crypto",
        "cfd",
        "commodity",
        null
      ]
    },
    "fees": {
      "type": [
        "number",
        "null"
      ]
    },
    "grossPnl": {
      "type": [
        "number",
        "null"
      ]
    },
    "contractMultiplier": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "underlying": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "optionType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "call",
        "put",
        null
      ]
    },
    "strike": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "expiry": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "externalId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "importSource": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "importBatchId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    }
  }
}
