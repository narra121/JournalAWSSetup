# Local `bun run dev` (src/app/server.ts, port 3001). Mirrors the EnvironmentVariables of ApiRevision in template.yaml.
# Needs AWS credentials for the dev stack (aws sso / profile): the tables, buckets and SSM parameters below are the deployed ones.

AWS_REGION=us-east-1
PORT=3001
LOG_LEVEL=info
STAGE_NAME=dev

# DynamoDB (TableName values of template.yaml with StageName=dev, ApiVersion=v1)
TRADES_TABLE=Trades-dev-v1
DAILY_STATS_TABLE=DailyStats-dev
RATE_LIMIT_TABLE=AuthRateLimit-dev
ACCOUNTS_TABLE=Accounts-dev
GOALS_TABLE=Goals-dev
RULES_TABLE=Rules-dev
USER_PREFERENCES_TABLE=UserPreferences-dev
SAVED_OPTIONS_TABLE=SavedOptions-dev
SUBSCRIPTIONS_TABLE=Subscriptions-dev
AI_DATA_TABLE=AiData-dev
USAGE_TABLE=Usage-dev

# S3 (bucket names are generated by CloudFormation: see the ImagesBucketName / ErrorReportsBucketName stack outputs)
IMAGES_BUCKET=
ERROR_REPORTS_BUCKET=

# Cognito (stack outputs of the dev user pool)
USER_POOL_ID=us-east-1_xxxxxxxxx
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS: the local frontend (vite) runs on 8080
ALLOWED_ORIGINS=http://localhost:8080

# Secrets live in SSM, not in env vars: these are the parameter NAMES (template defaults; keys are stored under /tradequt/dev/)
GEMINI_API_KEY_PARAM=/tradequt/geminiApiKey
GEMINI_REQUEST_TIMEOUT_MS=50000
STRIPE_SECRET_KEY_PARAM=/tradequt/dev/stripeSecretKey
STRIPE_WEBHOOK_SECRET_PARAM=/tradequt/dev/stripeWebhookSecret
ADMIN_SECRET_PARAM=/tradequt/adminSecret
ADMIN_JWT_SECRET_PARAM=/tradequt/adminJwtSecret
AD_CONFIG_PARAM=/tradequt/dev/adConfig

# E-mail links and sender
FROM_EMAIL=TradeQut <noreply@tradequt.com>
APP_URL=http://localhost:8080
