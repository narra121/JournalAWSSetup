{
  "name": "trading-journal-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "bun --watch src/app/server.ts",
    "deploy:dev": "node scripts/deploy.mjs --stage dev",
    "deploy:dev:dry": "node scripts/deploy.mjs --stage dev --dry-run",
    "deploy:prod:dry": "node scripts/deploy.mjs --stage prod --dry-run",
    "deploy:prod": "node scripts/deploy.mjs --stage prod --confirm-prod",
    "backup:dev": "node scripts/backup.mjs --stage dev --out backups/dev",
    "contract:record": "node scripts/contract-test.mjs --record contract-before.json",
    "contract:compare": "node scripts/contract-test.mjs --compare contract-before.json",
    "stripe:setup-test": "node scripts/stripe/setup-test.mjs",
    "stripe:live-dry": "node scripts/stripe/create-live-prices.mjs",
    "status:dev": "aws cloudformation describe-stacks --stack-name tradequt-dev --query \"Stacks[0].{StackStatus:StackStatus,LastUpdated:LastUpdatedTime}\"",
    "status:prod": "aws cloudformation describe-stacks --stack-name tradequt-prod --query \"Stacks[0].{StackStatus:StackStatus,LastUpdated:LastUpdatedTime}\"",
    "outputs:dev": "aws cloudformation describe-stacks --stack-name tradequt-dev --query \"Stacks[0].Outputs\"",
    "outputs:prod": "aws cloudformation describe-stacks --stack-name tradequt-prod --query \"Stacks[0].Outputs\"",
    "logs:dev": "aws logs tail /aws/lambda/web/tradequt-dev-api --follow",
    "logs:prod": "aws logs tail /aws/lambda/web/tradequt-prod-api --follow",
    "validate": "sam validate --lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1166.0",
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/client-ses": "^3.1166.0",
    "@aws-sdk/client-ssm": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@hono/node-server": "^2.1.7",
    "ajv": "8.18.0",
    "ajv-formats": "^3.0.1",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.13.18",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^17.7.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "js-yaml": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "qs": "^6.15.4"
  }
}
